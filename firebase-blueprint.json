{
  "entities": {
    "PilotDossier": {
      "title": "PilotDossier",
      "description": "Authenticated pilot profile, hull preferences, and dual-bucket combat statistics.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "callsign": {
          "type": "string",
          "description": "Pilot display callsign in space and on leaderboards."
        },
        "syndicateTag": {
          "type": "string",
          "description": "Optional Syndicate tag."
        },
        "syndicateName": {
          "type": "string",
          "description": "Optional Syndicate name."
        },
        "preferredShipId": {
          "type": "integer",
          "description": "Selected hull ID (1-10)."
        },
        "preferredFoundry": {
          "type": "string",
          "description": "Selected ship role or classification."
        },
        "preferredMode": {
          "type": "string",
          "enum": [
            "FFA",
            "SECTOR_CONVERGENCE",
            "SECTOR_CONVERGENCE_2",
            "RIFT_SKIRMISH",
            "RIFT_CONTROL",
            "FLUX_CORE",
            "STASIS_BREACH",
            "SYNDICATE_WARS",
            "NEXUS_LOBBY",
            "RIFT_LOBBY",
            "warzone_10v10",
            "ranked_3v3",
            "ranked_5v5"
          ],
          "description": "Selected combat arena queue."
        },
        "pvpKills": {
          "type": "integer",
          "description": "Eliminations scored against real human pilots."
        },
        "pvpDeaths": {
          "type": "integer",
          "description": "Deaths suffered from real human pilots."
        },
        "pvpBountyPeak": {
          "type": "integer",
          "description": "Highest Resonance achieved in PVP combat."
        },
        "allTimeKills": {
          "type": "integer",
          "description": "Total eliminations across human pilots and AI bots."
        },
        "allTimeDeaths": {
          "type": "integer",
          "description": "Total deaths across human pilots and AI bots."
        },
        "allTimeBountyPeak": {
          "type": "integer",
          "description": "Highest Resonance achieved across all sessions."
        },
        "convergencesWon": {
          "type": "integer",
          "description": "Number of Sector Convergence or Ranked match victories."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of dossier creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last dossier update (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "callsign",
        "preferredShipId",
        "preferredFoundry",
        "preferredMode",
        "pvpKills",
        "pvpDeaths",
        "pvpBountyPeak",
        "allTimeKills",
        "allTimeDeaths",
        "allTimeBountyPeak",
        "convergencesWon",
        "createdAt",
        "updatedAt"
      ]
    },
