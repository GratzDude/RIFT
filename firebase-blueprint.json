{
  "entities": {
    "PilotDossier": {
      "title": "PilotDossier",
      "description": "Authenticated pilot profile, hull preferences, and dual-bucket combat statistics.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "callsign": {
          "type": "string",
          "description": "Pilot display callsign in space and on leaderboards."
        },
        "preferredShipId": {
          "type": "integer",
          "description": "Selected hull ID (1-10)."
        },
        "preferredFoundry": {
          "type": "string",
          "description": "Selected ship role or classification."
        },
        "preferredMode": {
          "type": "string",
          "enum": [
            "FFA",
            "SECTOR_CONVERGENCE",
            "RIFT_SKIRMISH",
            "FLUX_CORE",
            "STASIS_BREACH",
            "SYNDICATE_WARS",
            "warzone_10v10",
            "ranked_3v3",
            "ranked_5v5"
          ],
          "description": "Selected combat arena queue."
        },
        "pvpKills": {
          "type": "integer",
          "description": "Eliminations scored against real human pilots."
        },
        "pvpDeaths": {
          "type": "integer",
          "description": "Deaths suffered from real human pilots."
        },
        "pvpBountyPeak": {
          "type": "integer",
          "description": "Highest bounty achieved in PVP combat."
        },
        "allTimeKills": {
          "type": "integer",
          "description": "Total eliminations across human pilots and AI bots."
        },
        "allTimeDeaths": {
          "type": "integer",
          "description": "Total deaths across human pilots and AI bots."
        },
        "allTimeBountyPeak": {
          "type": "integer",
          "description": "Highest bounty achieved across all sessions."
        },
        "convergencesWon": {
          "type": "integer",
          "description": "Number of Sector Convergence or Ranked match victories."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of dossier creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last dossier update (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "callsign",
        "preferredShipId",
        "preferredFoundry",
        "preferredMode",
        "pvpKills",
        "pvpDeaths",
        "pvpBountyPeak",
        "allTimeKills",
        "allTimeDeaths",
        "allTimeBountyPeak",
        "convergencesWon",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Publicly readable competitive leaderboard entry without PII.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Visibility scope for query enforcement."
        },
        "callsign": {
          "type": "string",
          "description": "Pilot callsign."
        },
        "shipId": {
          "type": "integer",
          "description": "Active hull ID (1-10)."
        },
        "syndicateTag": {
          "type": "string",
          "description": "Optional 2-4 char Syndicate tag."
        },
        "armadaTag": {
          "type": "string",
          "description": "Optional Armada squad tag or SOLO."
        },
        "armadaTierSize": {
          "type": "integer",
          "description": "Active Armada size bracket (1-5)."
        },
        "foundry": {
          "type": "string",
          "description": "Active ship role classification."
        },
        "pvpKills": {
          "type": "integer",
          "description": "Human-only PVP kills."
        },
        "pvpDeaths": {
          "type": "integer",
          "description": "Human-only PVP deaths."
        },
        "pvpBounty": {
          "type": "integer",
          "description": "Peak or active PVP bounty."
        },
        "allTimeKills": {
          "type": "integer",
          "description": "All-time kills (PVP + Bots)."
        },
        "allTimeDeaths": {
          "type": "integer",
          "description": "All-time deaths (PVP + Bots)."
        },
        "allTimeBounty": {
          "type": "integer",
          "description": "Peak all-time bounty."
        },
        "convergencesWon": {
          "type": "integer",
          "description": "Sector convergences and ranked matches won."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of entry creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "visibility",
        "callsign",
        "shipId",
        "foundry",
        "pvpKills",
        "pvpDeaths",
        "pvpBounty",
        "allTimeKills",
        "allTimeDeaths",
        "allTimeBounty",
        "convergencesWon",
        "createdAt",
        "updatedAt"
      ]
    },
    "LivePilotState": {
      "title": "LivePilotState",
      "description": "Real-time sector presence, ship telemetry, and holo-ping state for human pilots.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "sectorId": {
          "type": "string",
          "enum": [
            "FFA",
            "SECTOR_CONVERGENCE",
            "RIFT_SKIRMISH",
            "FLUX_CORE",
            "STASIS_BREACH",
            "SYNDICATE_WARS",
            "warzone_10v10",
            "ranked_3v3",
            "ranked_5v5"
          ],
          "description": "Sector queue identifier."
        },
        "callsign": {
          "type": "string",
          "description": "Pilot callsign."
        },
        "syndicateTag": {
          "type": "string",
          "description": "Pilot Syndicate tag."
        },
        "armadaName": {
          "type": "string",
          "description": "Active Armada name."
        },
        "shipId": {
          "type": "integer",
          "description": "Active ship hull (1-10)."
        },
        "freq": {
          "type": "integer",
          "description": "Team frequency (0 for West/Allied, 1 for East/Rival)."
        },
        "x": {
          "type": "number",
          "description": "World X coordinate."
        },
        "y": {
          "type": "number",
          "description": "World Y coordinate."
        },
        "vx": {
          "type": "number",
          "description": "Velocity X component."
        },
        "vy": {
          "type": "number",
          "description": "Velocity Y component."
        },
        "angle": {
          "type": "number",
          "description": "Ship heading in radians."
        },
        "weaponAngle": {
          "type": "number",
          "description": "Independent turret aim heading in radians."
        },
        "isFiringPrimary": {
          "type": "boolean",
          "description": "Whether the pilot is actively firing primary weapons."
        },
        "isAfterburning": {
          "type": "boolean",
          "description": "Whether Afterburners are engaged."
        },
        "isCloaked": {
          "type": "boolean",
          "description": "Whether stealth cloak is active."
        },
        "energy": {
          "type": "integer",
          "description": "Current unified Flux capacitor value."
        },
        "maxEnergy": {
          "type": "integer",
          "description": "Maximum unified Flux capacitor capacity."
        },
        "bounty": {
          "type": "integer",
          "description": "Current active bounty in sector."
        },
        "lastPingType": {
          "type": "string",
          "enum": ["NONE", "ATTACK", "DEFEND", "CONVERGENCE"],
          "description": "Latest tactical holo-ping broadcast."
        },
        "lastPingX": {
          "type": "number",
          "description": "World X coordinate of holo-ping."
        },
        "lastPingY": {
          "type": "number",
          "description": "World Y coordinate of holo-ping."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of presence creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest telemetry heartbeat."
        }
      },
      "required": [
        "userId",
        "sectorId",
        "callsign",
        "shipId",
        "freq",
        "x",
        "y",
        "vx",
        "vy",
        "angle",
        "energy",
        "maxEnergy",
        "bounty",
        "lastPingType",
        "lastPingX",
        "lastPingY",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyndicateInfo": {
      "title": "SyndicateInfo",
      "description": "Player-founded Syndicate directory entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Founder Firebase Auth UID."
        },
        "tag": {
          "type": "string",
          "description": "2-4 character Syndicate tag."
        },
        "name": {
          "type": "string",
          "description": "Syndicate display name."
        },
        "foundryOrigin": {
          "type": "string",
          "description": "Syndicate origin sector."
        },
        "motto": {
          "type": "string",
          "description": "Syndicate tactical motto."
        },
        "memberCount": {
          "type": "integer",
          "description": "Active Syndicate member count."
        },
        "combinedBounty": {
          "type": "integer",
          "description": "Combined Syndicate bounty."
        },
        "isCustom": {
          "type": "boolean",
          "description": "True for player-registered Syndicates."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of Syndicate creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last Syndicate update."
        }
      },
      "required": [
        "ownerId",
        "tag",
        "name",
        "foundryOrigin",
        "motto",
        "memberCount",
        "combinedBounty",
        "isCustom",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyndicateChatMessage": {
      "title": "SyndicateChatMessage",
      "description": "Sector comms message or Armada recruitment broadcast.",
      "type": "object",
      "properties": {
        "senderUid": {
          "type": "string",
          "description": "Sender Firebase Auth UID."
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Visibility scope for query enforcement."
        },
        "senderCallsign": {
          "type": "string",
          "description": "Sender pilot callsign."
        },
        "senderSyndicateTag": {
          "type": "string",
          "description": "Sender Syndicate tag."
        },
        "timestampLabel": {
          "type": "string",
          "description": "Formatted timestamp label."
        },
        "messageText": {
          "type": "string",
          "description": "Sanitized message text."
        },
        "isArmadaRecruitBanner": {
          "type": "boolean",
          "description": "Whether this message is an Armada recruitment banner."
        },
        "armadaName": {
          "type": "string",
          "description": "Armada squad name."
        },
        "armadaCurrentSize": {
          "type": "integer",
          "description": "Current Armada member count (1-5)."
        },
        "armadaMaxSize": {
          "type": "integer",
          "description": "Max Armada member count (1-5)."
        },
        "armadaObjective": {
          "type": "string",
          "description": "Armada tactical objective."
        },
        "requestSent": {
          "type": "boolean",
          "description": "Request state flag."
        },
        "createdAtMs": {
          "type": "integer",
          "description": "Client epoch timestamp in ms."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of message creation."
        }
      },
      "required": [
        "senderUid",
        "visibility",
        "senderCallsign",
        "senderSyndicateTag",
        "timestampLabel",
        "messageText",
        "isArmadaRecruitBanner",
        "armadaName",
        "armadaCurrentSize",
        "armadaMaxSize",
        "armadaObjective",
        "requestSent",
        "createdAtMs",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/PilotDossier"
      },
      "description": "Owner-isolated pilot dossier and persistent combat record."
    },
    "/leaderboard/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global dual-bucket competitive leaderboard (PVP Only and All-Time)."
    },
    "/sector_pilots/{userId}": {
      "schema": {
        "$ref": "#/entities/LivePilotState"
      },
      "description": "Real-time human pilot telemetry and tactical holo-pings per sector."
    },
    "/syndicates/{syndicateTag}": {
      "schema": {
        "$ref": "#/entities/SyndicateInfo"
      },
      "description": "Player-founded Syndicates directory."
    },
    "/sector_comms/{commId}": {
      "schema": {
        "$ref": "#/entities/SyndicateChatMessage"
      },
      "description": "Real-time Sector Comms and Armada recruitment broadcasts."
    }
  }
}
