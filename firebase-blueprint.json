        "vy": {
          "type": "number",
          "description": "Velocity Y component."
        },
        "angle": {
          "type": "number",
          "description": "Ship heading in radians."
        },
        "weaponAngle": {
          "type": "number",
          "description": "Independent turret aim heading in radians."
        },
        "isFiringPrimary": {
          "type": "boolean",
          "description": "Whether the pilot is actively firing primary weapons."
        },
        "isAfterburning": {
          "type": "boolean",
          "description": "Whether Afterburners are engaged."
        },
        "isCloaked": {
          "type": "boolean",
          "description": "Whether stealth cloak is active."
        },
        "isRespawning": {
          "type": "boolean",
          "description": "Whether the ship is currently respawning."
        },
        "isInStasisBrig": {
          "type": "boolean",
          "description": "Whether the ship is held in Stasis Breach containment."
        },
        "secondarySeq": {
          "type": "integer",
          "description": "Monotonic secondary ordnance sequence counter."
        },
        "secondaryType": {
          "type": "string",
          "description": "Active secondary ordnance type."
        },
        "secondaryAim": {
          "type": "number",
          "description": "Secondary ordnance aim angle in radians."
        },
        "energy": {
          "type": "integer",
          "description": "Current unified Flux capacitor value."
        },
        "maxEnergy": {
          "type": "integer",
          "description": "Maximum unified Flux capacitor capacity."
        },
        "bounty": {
          "type": "integer",
          "description": "Current active combat Resonance in sector."
        },
        "liveResonance": {
          "type": "integer",
          "description": "Overall Pilot Resonance rating."
        },
        "lastPingType": {
          "type": "string",
          "enum": ["NONE", "ATTACK", "DEFEND", "CONVERGENCE"],
          "description": "Latest tactical holo-ping broadcast."
        },
        "lastPingX": {
          "type": "number",
          "description": "World X coordinate of holo-ping."
        },
        "lastPingY": {
          "type": "number",
          "description": "World Y coordinate of holo-ping."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of presence creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest telemetry heartbeat (FieldValue.serverTimestamp())."
        }
      },
