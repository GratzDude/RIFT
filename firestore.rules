rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 8 && code.matches('^[A-Z0-9]+$');
    }

    function isValidFoundry(f) {
      return f is string && f.size() >= 1 && f.size() <= 40;
    }

    function isValidSectorMode(m) {
      return m is string && m.size() <= 30 && (
        m in [
          'FFA',
          'SECTOR_CONVERGENCE',
          'SECTOR_CONVERGENCE_2',
          'RIFT_SKIRMISH',
          'RIFT_CONTROL',
          'FLUX_CORE',
          'STASIS_BREACH',
          'SYNDICATE_WARS',
          'NEXUS_LOBBY',
          'RIFT_LOBBY',
          'warzone_10v10',
          'ranked_3v3',
          'ranked_5v5'
        ] ||
        m.matches('^CUSTOM_[a-zA-Z0-9_\\-]{1,23}$')
      );
    }

    // 1. PilotDossier Validation Blueprint
    function isValidPilotDossier(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.callsign is string && data.callsign.size() >= 2 && data.callsign.size() <= 24 &&
             (!('syndicateTag' in data) || (data.syndicateTag is string && data.syndicateTag.size() <= 12)) &&
             (!('syndicateName' in data) || (data.syndicateName is string && data.syndicateName.size() <= 48)) &&
             data.preferredShipId is int && data.preferredShipId >= 1 && data.preferredShipId <= 10 &&
             isValidFoundry(data.preferredFoundry) &&
             isValidSectorMode(data.preferredMode) &&
             data.pvpKills is int && data.pvpKills >= 0 && data.pvpKills <= 10000000 &&
             data.pvpDeaths is int && data.pvpDeaths >= 0 && data.pvpDeaths <= 10000000 &&
             data.pvpBountyPeak is int && data.pvpBountyPeak >= 0 && data.pvpBountyPeak <= 100000000 &&
             data.allTimeKills is int && data.allTimeKills >= 0 && data.allTimeKills <= 10000000 &&
             data.allTimeDeaths is int && data.allTimeDeaths >= 0 && data.allTimeDeaths <= 10000000 &&
             data.allTimeBountyPeak is int && data.allTimeBountyPeak >= 0 && data.allTimeBountyPeak <= 100000000 &&
             data.convergencesWon is int && data.convergencesWon >= 0 && data.convergencesWon <= 1000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 2. LeaderboardEntry Validation Blueprint
    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
             data.callsign is string && data.callsign.size() >= 2 && data.callsign.size() <= 24 &&
             data.shipId is int && data.shipId >= 1 && data.shipId <= 10 &&
             (!('syndicateTag' in data) || (data.syndicateTag is string && data.syndicateTag.size() <= 12)) &&
             (!('armadaTag' in data) || (data.armadaTag is string && data.armadaTag.size() <= 16)) &&
             (!('armadaTierSize' in data) || (data.armadaTierSize is int && data.armadaTierSize >= 1 && data.armadaTierSize <= 5)) &&
             isValidFoundry(data.foundry) &&
             data.pvpKills is int && data.pvpKills >= 0 && data.pvpKills <= 10000000 &&
             data.pvpDeaths is int && data.pvpDeaths >= 0 && data.pvpDeaths <= 10000000 &&
             data.pvpBounty is int && data.pvpBounty >= 0 && data.pvpBounty <= 100000000 &&
             data.allTimeKills is int && data.allTimeKills >= 0 && data.allTimeKills <= 10000000 &&
             data.allTimeDeaths is int && data.allTimeDeaths >= 0 && data.allTimeDeaths <= 10000000 &&
             data.allTimeBounty is int && data.allTimeBounty >= 0 && data.allTimeBounty <= 100000000 &&
             data.convergencesWon is int && data.convergencesWon >= 0 && data.convergencesWon <= 1000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 3. LivePilotState Validation Blueprint
    function isValidLivePilotState(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             (!('visibility' in data) || (data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public')) &&
             isValidSectorMode(data.sectorId) &&
             data.callsign is string && data.callsign.size() >= 2 && data.callsign.size() <= 24 &&
             (!('syndicateTag' in data) || (data.syndicateTag is string && data.syndicateTag.size() <= 12)) &&
             (!('armadaName' in data) || (data.armadaName is string && data.armadaName.size() <= 16)) &&
             data.shipId is int && data.shipId >= 1 && data.shipId <= 10 &&
             data.freq is int && data.freq >= 0 && data.freq <= 99 &&
             (data.x is int || data.x is float) && data.x >= -100000 && data.x <= 100000 &&
             (data.y is int || data.y is float) && data.y >= -100000 && data.y <= 100000 &&
             (data.vx is int || data.vx is float) && data.vx >= -5000 && data.vx <= 5000 &&
             (data.vy is int || data.vy is float) && data.vy >= -5000 && data.vy <= 5000 &&
             (data.angle is int || data.angle is float) && data.angle >= -100 && data.angle <= 100 &&
             (!('weaponAngle' in data) || ((data.weaponAngle is int || data.weaponAngle is float) && data.weaponAngle >= -100 && data.weaponAngle <= 100)) &&
             (!('isFiringPrimary' in data) || data.isFiringPrimary is bool) &&
             (!('isAfterburning' in data) || data.isAfterburning is bool) &&
             (!('isCloaked' in data) || data.isCloaked is bool) &&
             (!('isRespawning' in data) || data.isRespawning is bool) &&
             (!('isInStasisBrig' in data) || data.isInStasisBrig is bool) &&
             (!('secondarySeq' in data) || (data.secondarySeq is int && data.secondarySeq >= 0 && data.secondarySeq <= 100000000)) &&
             (!('secondaryType' in data) || (data.secondaryType is string && data.secondaryType.size() <= 28)) &&
             (!('secondaryAim' in data) || ((data.secondaryAim is int || data.secondaryAim is float) && data.secondaryAim >= -100 && data.secondaryAim <= 100)) &&
             data.energy is int && data.energy >= 0 && data.energy <= 10000 &&
             data.maxEnergy is int && data.maxEnergy >= 100 && data.maxEnergy <= 10000 &&
             data.bounty is int && data.bounty >= 0 && data.bounty <= 100000000 &&
             (!('liveResonance' in data) || (data.liveResonance is int && data.liveResonance >= 0 && data.liveResonance <= 1000000)) &&
             data.lastPingType is string && data.lastPingType.size() <= 16 &&
             data.lastPingType in ['NONE', 'ATTACK', 'DEFEND', 'CONVERGENCE'] &&
             (data.lastPingX is int || data.lastPingX is float) && data.lastPingX >= -100000 && data.lastPingX <= 100000 &&
             (data.lastPingY is int || data.lastPingY is float) && data.lastPingY >= -100000 && data.lastPingY <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. SyndicateInfo Validation Blueprint
    function isValidSyndicateInfo(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             data.tag is string && data.tag.size() >= 1 && data.tag.size() <= 4 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 36 &&
             isValidFoundry(data.foundryOrigin) &&
             data.motto is string && data.motto.size() >= 1 && data.motto.size() <= 64 &&
             data.memberCount is int && data.memberCount >= 1 && data.memberCount <= 100000 &&
             data.combinedBounty is int && data.combinedBounty >= 0 && data.combinedBounty <= 1000000000 &&
             data.isCustom is bool && data.isCustom == true &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 5. SyndicateChatMessage Validation Blueprint
    function isValidSectorComm(data) {
      return data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderUid == request.auth.uid &&
             data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
             data.senderCallsign is string && data.senderCallsign.size() >= 2 && data.senderCallsign.size() <= 24 &&
             data.senderSyndicateTag is string && data.senderSyndicateTag.size() <= 12 &&
             data.timestampLabel is string && data.timestampLabel.size() >= 1 && data.timestampLabel.size() <= 24 &&
             data.messageText is string && data.messageText.size() <= 240 &&
             data.isArmadaRecruitBanner is bool &&
             data.armadaName is string && data.armadaName.size() <= 16 &&
             data.armadaCurrentSize is int && data.armadaCurrentSize >= 1 && data.armadaCurrentSize <= 5 &&
             data.armadaMaxSize is int && data.armadaMaxSize >= 1 && data.armadaMaxSize <= 5 &&
             data.armadaObjective is string && data.armadaObjective.size() <= 120 &&
             data.requestSent is bool &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 6. SectorCombatEvent Validation Blueprint (Cross-Device Hit, Elimination & Resonance Credit)
    function isValidSectorCombatEvent(data) {
      return data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderUid == request.auth.uid &&
             data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             isValidSectorMode(data.sectorId) &&
             data.eventType is string && data.eventType in ['HIT', 'ELIMINATED'] &&
             data.damage is int && data.damage >= 0 && data.damage <= 25000 &&
             data.bountyAward is int && data.bountyAward >= 0 && data.bountyAward <= 100000000 &&
             data.weaponLabel is string && data.weaponLabel.size() <= 48 &&
             data.senderCallsign is string && data.senderCallsign.size() >= 2 && data.senderCallsign.size() <= 24 &&
             data.senderTag is string && data.senderTag.size() <= 16 &&
             data.senderShipId is int && data.senderShipId >= 1 && data.senderShipId <= 10 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 7. SectorInstanceState Validation Blueprint (Shared Mode Objectives: Flux Core, Rift Control, Stasis Breach)
    function isValidSectorInstanceState(data) {
      return isValidSectorMode(data.sectorId) &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostUid == request.auth.uid &&
             data.fluxCarrierUid is string && data.fluxCarrierUid.size() <= 128 &&
             (data.fluxOrbX is int || data.fluxOrbX is float) && data.fluxOrbX >= -100000 && data.fluxOrbX <= 100000 &&
             (data.fluxOrbY is int || data.fluxOrbY is float) && data.fluxOrbY >= -100000 && data.fluxOrbY <= 100000 &&
             (data.fluxOrbVx is int || data.fluxOrbVx is float) && data.fluxOrbVx >= -5000 && data.fluxOrbVx <= 5000 &&
             (data.fluxOrbVy is int || data.fluxOrbVy is float) && data.fluxOrbVy >= -5000 && data.fluxOrbVy <= 5000 &&
             data.fluxTier is int && data.fluxTier >= 0 && data.fluxTier <= 10 &&
             (data.fluxHoldSec is int || data.fluxHoldSec is float) && data.fluxHoldSec >= 0 && data.fluxHoldSec <= 3600 &&
             (data.rcWestScore is int || data.rcWestScore is float) && data.rcWestScore >= 0 && data.rcWestScore <= 1000 &&
             (data.rcEastScore is int || data.rcEastScore is float) && data.rcEastScore >= 0 && data.rcEastScore <= 1000 &&
             (data.rcTimerSec is int || data.rcTimerSec is float) && data.rcTimerSec >= 0 && data.rcTimerSec <= 600 &&
             (data.rcAlphaCtrl is int || data.rcAlphaCtrl is float) && data.rcAlphaCtrl >= -30 && data.rcAlphaCtrl <= 30 &&
             data.rcAlphaLock is int && data.rcAlphaLock >= -1 && data.rcAlphaLock <= 2 &&
             (data.rcOmegaCtrl is int || data.rcOmegaCtrl is float) && data.rcOmegaCtrl >= -30 && data.rcOmegaCtrl <= 30 &&
             data.rcOmegaLock is int && data.rcOmegaLock >= -1 && data.rcOmegaLock <= 2 &&
             (data.sbTimerSec is int || data.sbTimerSec is float) && data.sbTimerSec >= 0 && data.sbTimerSec <= 600 &&
             data.sbWestCaps is int && data.sbWestCaps >= 0 && data.sbWestCaps <= 10000 &&
             data.sbEastCaps is int && data.sbEastCaps >= 0 && data.sbEastCaps <= 10000 &&
             (data.sbWestCoreHp is int || data.sbWestCoreHp is float) && data.sbWestCoreHp >= 0 && data.sbWestCoreHp <= 250000 &&
             (data.sbEastCoreHp is int || data.sbEastCoreHp is float) && data.sbEastCoreHp >= 0 && data.sbEastCoreHp <= 250000 &&
             data.jailedUidsCsv is string && data.jailedUidsCsv.size() <= 640 &&
             data.updatedAtMs is int && data.updatedAtMs >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 8. CustomGameRoom Validation Blueprint (Public Custom Game List + 6-Char Private Join Code Lookup)
    function isValidCustomGameRoom(data) {
      return isValidRoomCode(data.roomCode) &&
             data.instanceId is string && data.instanceId.size() >= 4 && data.instanceId.size() <= 23 &&
             data.instanceId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostUid == request.auth.uid &&
             data.hostCallsign is string && data.hostCallsign.size() >= 2 && data.hostCallsign.size() <= 24 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 48 &&
             data.visibility is string && data.visibility.size() <= 8 &&
             data.visibility in ['public', 'private'] &&
             data.privateRoom is bool &&
             ((data.privateRoom == false && data.visibility == 'public') ||
              (data.privateRoom == true && data.visibility == 'private')) &&
             data.baseMode is string && data.baseMode.size() <= 24 &&
             data.baseMode in [
               'SECTOR_CONVERGENCE',
               'RIFT_SKIRMISH',
               'FLUX_CORE',
               'STASIS_BREACH',
               'RIFT_CONTROL',
               'SYNDICATE_WARS'
             ] &&
             data.teamSizeBracket is int && data.teamSizeBracket >= 1 && data.teamSizeBracket <= 20 &&
             data.matchDurationMinutes is int && data.matchDurationMinutes >= 0 && data.matchDurationMinutes <= 120 &&
             data.allowArmadasInFfa is bool &&
             data.botsEnabled is bool &&
             (data.bulletSizeMult is int || data.bulletSizeMult is float) && data.bulletSizeMult >= 0.25 && data.bulletSizeMult <= 4.0 &&
             (data.damageMult is int || data.damageMult is float) && data.damageMult >= 0.25 && data.damageMult <= 4.0 &&
             (data.speedMult is int || data.speedMult is float) && data.speedMult >= 0.25 && data.speedMult <= 3.0 &&
             (data.healthMult is int || data.healthMult is float) && data.healthMult >= 0.25 && data.healthMult <= 4.0 &&
             (data.rechargeMult is int || data.rechargeMult is float) && data.rechargeMult >= 0.25 && data.rechargeMult <= 4.0 &&
             (data.crateSpawnMult is int || data.crateSpawnMult is float) && data.crateSpawnMult >= 0.0 && data.crateSpawnMult <= 4.0 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Collection 1: /users/{userId} (Owner-Isolated PilotDossier)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'callsign', 'preferredShipId', 'preferredFoundry', 'preferredMode',
                         'pvpKills', 'pvpDeaths', 'pvpBountyPeak',
                         'allTimeKills', 'allTimeDeaths', 'allTimeBountyPeak',
                         'convergencesWon', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'callsign', 'syndicateTag', 'syndicateName',
                         'preferredShipId', 'preferredFoundry', 'preferredMode',
                         'pvpKills', 'pvpDeaths', 'pvpBountyPeak',
                         'allTimeKills', 'allTimeDeaths', 'allTimeBountyPeak',
                         'convergencesWon', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPilotDossier(incoming());

      allow update: if isSignedIn() &&
                       isValidPilotDossier(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'callsign', 'syndicateTag', 'syndicateName',
                         'preferredShipId', 'preferredFoundry', 'preferredMode',
                         'pvpKills', 'pvpDeaths', 'pvpBountyPeak',
                         'allTimeKills', 'allTimeDeaths', 'allTimeBountyPeak',
                         'convergencesWon', 'createdAt', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Collection 2: /leaderboard/{userId} (Publicly Queryable Non-PII Competitive Leaderboard)
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || existing().visibility == 'public');
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'visibility', 'callsign', 'shipId', 'foundry',
                         'pvpKills', 'pvpDeaths', 'pvpBounty',
                         'allTimeKills', 'allTimeDeaths', 'allTimeBounty',
                         'convergencesWon', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'visibility', 'callsign', 'shipId',
                         'syndicateTag', 'armadaTag', 'armadaTierSize', 'foundry',
                         'pvpKills', 'pvpDeaths', 'pvpBounty',
                         'allTimeKills', 'allTimeDeaths', 'allTimeBounty',
                         'convergencesWon', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidLeaderboardEntry(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().visibility == existing().visibility &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'callsign', 'shipId',
                         'syndicateTag', 'armadaTag', 'armadaTierSize', 'foundry',
                         'pvpKills', 'pvpDeaths', 'pvpBounty',
                         'allTimeKills', 'allTimeDeaths', 'allTimeBounty',
                         'convergencesWon', 'createdAt', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Collection 3: /sector_pilots/{userId} (Real-Time Sector Presence, Ordnance & Holo-Pings)
    match /sector_pilots/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || existing().visibility == 'public' || isValidSectorMode(existing().sectorId));
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().visibility == 'public' &&
                       incoming().keys().hasAll([
                         'userId', 'visibility', 'sectorId', 'callsign', 'shipId', 'freq',
                         'x', 'y', 'vx', 'vy', 'angle',
                         'energy', 'maxEnergy', 'bounty',
                         'lastPingType', 'lastPingX', 'lastPingY',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'visibility', 'sectorId', 'callsign', 'syndicateTag', 'armadaName',
                         'shipId', 'freq',
                         'x', 'y', 'vx', 'vy', 'angle', 'weaponAngle',
                         'isFiringPrimary', 'isAfterburning', 'isCloaked',
                         'isRespawning', 'isInStasisBrig',
                         'secondarySeq', 'secondaryType', 'secondaryAim',
                         'energy', 'maxEnergy', 'bounty', 'liveResonance',
                         'lastPingType', 'lastPingX', 'lastPingY',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidLivePilotState(incoming());

      allow update: if isSignedIn() &&
                       isValidLivePilotState(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().visibility == 'public' &&
                       incoming().keys().hasOnly([
                         'userId', 'visibility', 'sectorId', 'callsign', 'syndicateTag', 'armadaName',
                         'shipId', 'freq',
                         'x', 'y', 'vx', 'vy', 'angle', 'weaponAngle',
                         'isFiringPrimary', 'isAfterburning', 'isCloaked',
                         'isRespawning', 'isInStasisBrig',
                         'secondarySeq', 'secondaryType', 'secondaryAim',
                         'energy', 'maxEnergy', 'bounty', 'liveResonance',
                         'lastPingType', 'lastPingX', 'lastPingY',
                         'createdAt', 'updatedAt'
                       ]) &&
                       (!('userId' in existing()) || incoming().userId == existing().userId) &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Collection 4: /syndicates/{syndicateTag} (Player-Founded Syndicates Directory)
    match /syndicates/{syndicateTag} {
      allow get: if isSignedIn() && isValidId(syndicateTag) && (resource == null || existing().isCustom == true);
      allow list: if isSignedIn() && existing().isCustom == true;

      allow create: if isSignedIn() &&
                       isValidId(syndicateTag) &&
                       incoming().tag == syndicateTag &&
                       incoming().keys().hasAll([
                         'ownerId', 'tag', 'name', 'foundryOrigin', 'motto',
                         'memberCount', 'combinedBounty', 'isCustom', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'tag', 'name', 'foundryOrigin', 'motto',
                         'memberCount', 'combinedBounty', 'isCustom', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSyndicateInfo(incoming());

      allow update: if isSignedIn() &&
                       isValidSyndicateInfo(incoming()) &&
                       isValidId(syndicateTag) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().tag == existing().tag &&
                       incoming().isCustom == existing().isCustom &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'foundryOrigin', 'motto',
                         'memberCount', 'combinedBounty', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(syndicateTag) && existing().ownerId == request.auth.uid;
    }

    // Collection 5: /sector_comms/{commId} (Real-Time Sector Comms & Squadron Recruitment Broadcasts)
    match /sector_comms/{commId} {
      allow get: if isSignedIn() && isValidId(commId) && (resource == null || existing().visibility == 'public');
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isSignedIn() &&
                       isValidId(commId) &&
                       incoming().keys().hasAll([
                         'senderUid', 'visibility', 'senderCallsign', 'senderSyndicateTag',
                         'timestampLabel', 'messageText', 'isArmadaRecruitBanner',
                         'armadaName', 'armadaCurrentSize', 'armadaMaxSize',
                         'armadaObjective', 'requestSent', 'createdAtMs', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'senderUid', 'visibility', 'senderCallsign', 'senderSyndicateTag',
                         'timestampLabel', 'messageText', 'isArmadaRecruitBanner',
                         'armadaName', 'armadaCurrentSize', 'armadaMaxSize',
                         'armadaObjective', 'requestSent', 'createdAtMs', 'createdAt'
                       ]) &&
                       isValidSectorComm(incoming());

      allow update: if isSignedIn() &&
                       isValidSectorComm(incoming()) &&
                       isValidId(commId) &&
                       existing().senderUid == request.auth.uid &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'messageText', 'armadaCurrentSize', 'requestSent'
                       ]);

      allow delete: if isSignedIn() && isValidId(commId) && existing().senderUid == request.auth.uid;
    }

    // Collection 6: /sector_combat_events/{eventId} (Authoritative Cross-Device Hit & Elimination Events)
    match /sector_combat_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && (resource == null || isValidSectorMode(existing().sectorId));
      allow list: if isSignedIn() && isValidSectorMode(existing().sectorId);

      allow create: if isSignedIn() &&
                       isValidId(eventId) &&
                       incoming().keys().hasAll([
                         'senderUid', 'targetUid', 'sectorId', 'eventType',
                         'damage', 'bountyAward', 'weaponLabel',
                         'senderCallsign', 'senderTag', 'senderShipId',
                         'createdAtMs', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'senderUid', 'targetUid', 'sectorId', 'eventType',
                         'damage', 'bountyAward', 'weaponLabel',
                         'senderCallsign', 'senderTag', 'senderShipId',
                         'createdAtMs', 'createdAt'
                       ]) &&
                       isValidSectorCombatEvent(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(eventId) && existing().senderUid == request.auth.uid;
    }

    // Collection 7: /sector_instances/{sectorId} (Shared Objective Authority per Rift Instance)
    match /sector_instances/{sectorId} {
      allow get: if isSignedIn() && isValidSectorMode(sectorId);
      allow list: if isSignedIn() && isValidSectorMode(existing().sectorId);

      allow create, update: if isSignedIn() &&
                               isValidSectorMode(sectorId) &&
                               incoming().sectorId == sectorId &&
                               incoming().keys().hasAll([
                                 'sectorId', 'hostUid', 'fluxCarrierUid',
                                 'fluxOrbX', 'fluxOrbY', 'fluxOrbVx', 'fluxOrbVy',
                                 'fluxTier', 'fluxHoldSec',
                                 'rcWestScore', 'rcEastScore', 'rcTimerSec',
                                 'rcAlphaCtrl', 'rcAlphaLock', 'rcOmegaCtrl', 'rcOmegaLock',
                                 'sbTimerSec', 'sbWestCaps', 'sbEastCaps', 'sbWestCoreHp', 'sbEastCoreHp',
                                 'jailedUidsCsv', 'updatedAtMs', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'sectorId', 'hostUid', 'fluxCarrierUid',
                                 'fluxOrbX', 'fluxOrbY', 'fluxOrbVx', 'fluxOrbVy',
                                 'fluxTier', 'fluxHoldSec',
                                 'rcWestScore', 'rcEastScore', 'rcTimerSec',
                                 'rcAlphaCtrl', 'rcAlphaLock', 'rcOmegaCtrl', 'rcOmegaLock',
                                 'sbTimerSec', 'sbWestCaps', 'sbEastCaps', 'sbWestCoreHp', 'sbEastCoreHp',
                                 'jailedUidsCsv', 'updatedAtMs', 'updatedAt'
                               ]) &&
                               isValidSectorInstanceState(incoming());

      allow delete: if false;
    }

    // Collection 8: /custom_games/{roomCode} (Public Custom Game List + 6-Char Private Join Code Lookup)
    match /custom_games/{roomCode} {
      // Direct lookup by 6-char Join Code works for both Public and Private custom games when signed in
      allow get: if isSignedIn() && isValidRoomCode(roomCode);
      // List queries return strictly Public Custom Games; Private games are never exposed via list
      allow list: if isSignedIn() && existing().visibility == 'public' && existing().privateRoom == false;

      allow create: if isSignedIn() &&
                       isValidRoomCode(roomCode) &&
                       incoming().roomCode == roomCode &&
                       incoming().keys().hasAll([
                         'roomCode', 'instanceId', 'hostUid', 'hostCallsign', 'title',
                         'visibility', 'privateRoom', 'baseMode', 'teamSizeBracket',
                         'matchDurationMinutes', 'allowArmadasInFfa', 'botsEnabled',
                         'bulletSizeMult', 'damageMult', 'speedMult', 'healthMult',
                         'rechargeMult', 'crateSpawnMult', 'createdAtMs', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'instanceId', 'hostUid', 'hostCallsign', 'title',
                         'visibility', 'privateRoom', 'baseMode', 'teamSizeBracket',
                         'matchDurationMinutes', 'allowArmadasInFfa', 'botsEnabled',
                         'bulletSizeMult', 'damageMult', 'speedMult', 'healthMult',
                         'rechargeMult', 'crateSpawnMult', 'createdAtMs', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCustomGameRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidCustomGameRoom(incoming()) &&
                       isValidRoomCode(roomCode) &&
                       existing().hostUid == request.auth.uid &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'instanceId', 'hostCallsign', 'title', 'visibility', 'privateRoom',
                         'baseMode', 'teamSizeBracket', 'matchDurationMinutes',
                         'allowArmadasInFfa', 'botsEnabled', 'bulletSizeMult', 'damageMult',
                         'speedMult', 'healthMult', 'rechargeMult', 'crateSpawnMult',
                         'createdAtMs', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidRoomCode(roomCode) && existing().hostUid == request.auth.uid;
    }

    // Collection 9: /global_state/{docId} (Authenticated Syndicate Crest/Channels, Custom Calibration & Owner-Isolated Pilot Progression)
    match /global_state/{docId} {
      allow get: if isSignedIn() &&
                    isValidId(docId) &&
                    (!docId.matches('^pilot_prog_.*$') || docId == ('pilot_prog_' + request.auth.uid));
      allow list: if false;

      allow create, update: if isSignedIn() &&
                               isValidId(docId) &&
                               (
                                 (
                                   docId.matches('^syndicate_meta_[A-Z0-9_\\-]{1,4}$') &&
                                   incoming().keys().hasOnly([
                                     'tag', 'ownerId', 'crestJson', 'customChannelsJson',
                                     'invitedGuestsCsv', 'updatedAtMs'
                                   ]) &&
                                   incoming().ownerId == request.auth.uid &&
                                   (resource == null || !('ownerId' in existing()) || existing().ownerId == request.auth.uid) &&
                                   incoming().tag is string && incoming().tag.size() >= 1 && incoming().tag.size() <= 4 &&
                                   incoming().crestJson is string && incoming().crestJson.size() <= 4096 &&
                                   incoming().customChannelsJson is string && incoming().customChannelsJson.size() <= 1024 &&
                                   incoming().invitedGuestsCsv is string && incoming().invitedGuestsCsv.size() <= 1024 &&
                                   incoming().updatedAtMs is int
                                 ) ||
                                 (
                                   docId == 'custom_game_calibration' &&
                                   incoming().keys().hasOnly([
                                     'customGameId', 'authorCallsign', 'payloadJson', 'updatedAtMs'
                                   ]) &&
                                   incoming().customGameId is string && incoming().customGameId.size() <= 40 &&
                                   incoming().authorCallsign is string && incoming().authorCallsign.size() <= 24 &&
                                   incoming().payloadJson is string && incoming().payloadJson.size() <= 16384 &&
                                   incoming().updatedAtMs is int
                                 ) ||
                                 (
                                   docId == ('pilot_prog_' + request.auth.uid) &&
                                   incoming().keys().hasOnly([
                                     'ownerId', 'payloadJson', 'updatedAtMs'
                                   ]) &&
                                   incoming().ownerId == request.auth.uid &&
                                   (resource == null || !('ownerId' in existing()) || existing().ownerId == request.auth.uid) &&
                                   incoming().payloadJson is string && incoming().payloadJson.size() >= 2 && incoming().payloadJson.size() <= 16384 &&
                                   incoming().updatedAtMs is int
                                 )
                               );

      allow delete: if false;
    }

    // Collection 10: /sector_bug_reports/{reportId} (Authenticated Telemetry Bug Reports)
    match /sector_bug_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (resource == null || existing().reporterUid == request.auth.uid);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().keys().hasOnly([
                         'reporterUid', 'reporterCallsign', 'syndicateTag', 'category',
                         'description', 'buildVersion', 'activeMode', 'activeShipId',
                         'screenDpSummary', 'createdAtMs', 'createdAt'
                       ]) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().reporterCallsign is string && incoming().reporterCallsign.size() <= 24 &&
                       incoming().syndicateTag is string && incoming().syndicateTag.size() <= 12 &&
                       incoming().category is string && incoming().category.size() <= 32 &&
                       incoming().description is string && incoming().description.size() >= 1 && incoming().description.size() <= 240 &&
                       incoming().buildVersion is int &&
                       incoming().activeMode is string && incoming().activeMode.size() <= 32 &&
                       incoming().activeShipId is int && incoming().activeShipId >= 1 && incoming().activeShipId <= 10 &&
                       incoming().screenDpSummary is string && incoming().screenDpSummary.size() <= 48 &&
                       incoming().createdAtMs is int &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;

      allow update, delete: if false;
    }
  }
}
